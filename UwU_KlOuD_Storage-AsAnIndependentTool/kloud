class Handler(http.server.BaseHTTPRequestHandler):
    cfg = None
    server_version = "kloud/1"

    def log_message(self, fmt, *a):
        sys.stderr.write("%s - - [%s] %s\n" % (self.address_string(), self.log_date_time_string(), fmt % a))

    def _authed(self):
        auth = self.headers.get("Authorization", "")
        if not auth.startswith("Bearer "):
            return False
        token = auth[len("Bearer "):].strip()
        given_hash = hash_token(token, self.cfg["salt"])
        return hmac.compare_digest(given_hash, self.cfg["token_hash"])

    def _deny(self):
        self.send_response(401)
        self.send_header("WWW-Authenticate", 'Bearer realm="kloud"')
        self.end_headers()

    def _safe_path(self, name):
        name = unquote(name)
        if not name or "/" in name or name in (".", ".."):
            return None
        return Path(self.cfg["root"]) / name

    def do_GET(self):
        parsed = urlparse(self.path)
        if parsed.path == "/":
            body = INDEX_HTML.encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        if parsed.path == "/api/files":
            if not self._authed():
                return self._deny()
            root = Path(self.cfg["root"])
            files = []
            for p in sorted(root.iterdir()):
                if p.is_file() and not p.name.endswith(".part"):
                    st = p.stat()
                    files.append({
                        "name": p.name,
                        "size": st.st_size,
                        "mtime": datetime.fromtimestamp(st.st_mtime, tz=timezone.utc).isoformat(),
                    })
            body = json.dumps(files).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        if parsed.path.startswith("/api/files/"):
            if not self._authed():
                return self._deny()
            p = self._safe_path(parsed.path[len("/api/files/"):])
            if not p or not p.is_file():
                self.send_response(404)
                self.end_headers()
                return
            size = p.stat().st_size
            ctype = mimetypes.guess_type(p.name)[0] or "application/octet-stream"
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(size))
            self.send_header("Content-Disposition", f'attachment; filename="{p.name}"')
            self.end_headers()
            with p.open("rb") as f:
                while chunk := f.read(1 << 20):
                    self.wfile.write(chunk)
            return
        self.send_response(404)
        self.end_headers()

    def do_PUT(self):
        parsed = urlparse(self.path)
        if not parsed.path.startswith("/api/files/"):
            self.send_response(404); self.end_headers(); return
        if not self._authed():
            return self._deny()
        p = self._safe_path(parsed.path[len("/api/files/"):])
        if not p:
            self.send_response(400); self.end_headers(); return
        length = int(self.headers.get("Content-Length", 0))
        tmp = p.with_name(p.name + ".part")
        remaining = length
        with tmp.open("wb") as f:
            while remaining > 0:
                chunk = self.rfile.read(min(1 << 20, remaining))
                if not chunk:
                    break
                f.write(chunk)
                remaining -= len(chunk)
        tmp.replace(p)
        self.send_response(201)
        self.end_headers()

    def do_DELETE(self):
        parsed = urlparse(self.path)
        if not parsed.path.startswith("/api/files/"):
            self.send_response(404); self.end_headers(); return
        if not self._authed():
            return self._deny()
        p = self._safe_path(parsed.path[len("/api/files/"):])
        if not p or not p.is_file():
            self.send_response(404); self.end_headers(); return
        p.unlink()
        self.send_response(204)
        self.end_headers()


class ThreadingHTTPServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True


def cmd_serve(args):
    cfg = load_config()
    Handler.cfg = cfg
    server = ThreadingHTTPServer(("0.0.0.0", args.port), Handler)
    if cfg.get("tls"):
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.load_cert_chain(cfg["cert"], cfg["key"])
        server.socket = ctx.wrap_socket(server.socket, server_side=True)
        scheme = "https"
    else:
        scheme = "http"
    print(f"kloud serving {cfg['root']} on {scheme}://0.0.0.0:{args.port}")
    print("Reach it from another machine on the LAN with this machine's IP, e.g.:")
    print(f"  curl -H 'Authorization: Bearer <token>' {scheme}://<this-machine-ip>:{args.port}/api/files")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


def main():
    parser = argparse.ArgumentParser(prog="kloud", description="Self-hosted file store, zero dependencies.")
    sub = parser.add_subparsers(dest="cmd")

    p_init = sub.add_parser("init", help="point kloud at a folder/drive and generate an access token")
    p_init.add_argument("--root", required=True, help="path to store files in (e.g. your external SSD)")
    p_init.add_argument("--tls", action="store_true", help="generate a self-signed cert and serve over https")
    p_init.set_defaults(func=cmd_init)

    p_token = sub.add_parser("token-new", help="revoke the old token and issue a new one")
    p_token.set_defaults(func=cmd_token_new)

    p_serve = sub.add_parser("serve", help="start the server")
    p_serve.add_argument("--port", type=int, default=8443)
    p_serve.set_defaults(func=cmd_serve)

    p_safety = sub.add_parser("safety", help="print the security checklist and run live checks")
    p_safety.set_defaults(func=cmd_safety)

    p_menu = sub.add_parser("menu", help="interactive menu (same as running kloud with no arguments)")
    p_menu.set_defaults(func=cmd_menu)

    p_start = sub.add_parser("start", help="start the server in the background")
    p_start.add_argument("--port", type=int, default=8443)
    p_start.set_defaults(func=cmd_start)

    p_stop = sub.add_parser("stop", help="stop the background server")
    p_stop.set_defaults(func=cmd_stop)

    p_status = sub.add_parser("status", help="show storage/server/VPN/sync/schedule status")
    p_status.set_defaults(func=cmd_status)

    args = parser.parse_args()
    if args.cmd is None:
        cmd_menu(args)
    else:
        args.func(args)


if __name__ == "__main__":
    main()
