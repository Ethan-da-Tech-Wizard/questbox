def cmd_menu(args):
    """Run the interactive menu loop until the user quits.

    Every action runs inside try/except so a failed step (including sys.exit calls in the helpers, which
    raise SystemExit) returns to the menu instead of closing the program.
    """
    while True:
        print(MENU.format(status=_status_line()))
        choice = input("> ").strip().lower()
        try:
            # Menu dispatch: each number maps to one command or wizard; unknown input just reprompts.
            if choice == "1":
                wizard_first_time()
            elif choice == "2":
                cmd_start(argparse.Namespace(port=8443))
            elif choice == "3":
                cmd_stop(argparse.Namespace())
            elif choice == "4":
                wizard_vpn()
            elif choice == "5":
                wizard_sync()
            elif choice == "6":
                wizard_schedule()
            elif choice == "7":
                cmd_status(argparse.Namespace())
            elif choice == "8":
                wizard_token()
            elif choice == "9":
                cmd_safety(argparse.Namespace())
            elif choice in ("10", "q", "quit", "exit"):
                break
            else:
                print("Please enter a number from the menu.")

        # The helper functions call sys.exit("message") for user errors; catch it so the menu stays open and shows the message.
        except SystemExit as e:
            print(f"\n{e.code if isinstance(e.code, str) else 'That step stopped early.'}")
            print("Nothing was damaged -- you're back at the menu.")

        # Last-resort catch for the interactive loop only: unexpected errors are shown, then the user is returned to the menu.
        except Exception as e:
            print(f"\nSomething went wrong: {e}")
            print("Nothing was damaged -- you're back at the menu.")


# The whole browser UI is embedded here so the server stays a single stdlib-only file. Served at "/"
# without authentication (it contains no data); everything it shows comes from the authenticated
# /api/files calls it makes with the token typed into the page. The token is kept in sessionStorage
# (cleared when the tab closes) and sent as an Authorization header, never in a URL.
# Known weaknesses of this page: file names are inserted into innerHTML and onclick attributes without
# escaping, so a file name containing quotes or HTML would break the table or run script in the
# viewer's browser; only people holding the token can create such files, but names arriving through
# sync from another machine are also affected. Downloads are buffered in memory (blob), so very large
# files are better fetched with curl.
INDEX_HTML = """<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>kloud</title>
<style>
  :root { color-scheme: light dark; }
  body { font-family: -apple-system, system-ui, sans-serif; max-width: 720px; margin: 2rem auto; padding: 0 1rem; }
  h1 { font-size: 1.25rem; }
  #token { width: 100%; padding: .5rem; box-sizing: border-box; margin-bottom: .5rem; }
  table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
  td, th { text-align: left; padding: .4rem; border-bottom: 1px solid #8884; }
  button { cursor: pointer; }
  #drop { border: 2px dashed #8888; border-radius: 8px; padding: 2rem; text-align: center; margin-top: 1rem; }
</style>
</head>
<body>
<h1>kloud</h1>
<input id="token" type="password" placeholder="access token">
<div id="drop">drop files here, or <input id="file" type="file" multiple></div>
<table><thead><tr><th>name</th><th>size</th><th></th></tr></thead><tbody id="rows"></tbody></table>
<script>
function tok() { return sessionStorage.getItem('kloud_token') || ''; }
document.getElementById('token').value = tok();
document.getElementById('token').addEventListener('input', e => {
  sessionStorage.setItem('kloud_token', e.target.value);
});
document.getElementById('token').addEventListener('change', refresh);

async function refresh() {
  const res = await fetch('/api/files', { headers: { Authorization: 'Bearer ' + tok() } });
  if (!res.ok) { document.getElementById('rows').innerHTML = '<tr><td colspan=3>enter a valid token</td></tr>'; return; }
  const files = await res.json();
  document.getElementById('rows').innerHTML = files.map(f => `
    <tr>
      <td>${f.name}</td>
      <td>${(f.size/1024/1024).toFixed(2)} MB</td>
      <td>
        <button onclick="dl('${f.name}')">download</button>
        <button onclick="del('${f.name}')">delete</button>
      </td>
    </tr>`).join('');
}

async function upload(file) {
  await fetch('/api/files/' + encodeURIComponent(file.name), {
    method: 'PUT',
    headers: { Authorization: 'Bearer ' + tok() },
    body: file,
  });
  refresh();
}

async function dl(name) {
  const res = await fetch('/api/files/' + encodeURIComponent(name), { headers: { Authorization: 'Bearer ' + tok() } });
  const blob = await res.blob();
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = name; a.click();
  URL.revokeObjectURL(url);
}

async function del(name) {
  if (!confirm('delete ' + name + '?')) return;
  await fetch('/api/files/' + encodeURIComponent(name), {
    method: 'DELETE',
    headers: { Authorization: 'Bearer ' + tok() },
  });
  refresh();
}

document.getElementById('file').addEventListener('change', e => {
  [...e.target.files].forEach(upload);
});
const drop = document.getElementById('drop');
drop.addEventListener('dragover', e => e.preventDefault());
drop.addEventListener('drop', e => {
  e.preventDefault();
  [...e.dataTransfer.files].forEach(upload);
});
refresh();
</script>
</body>
</html>
"""


# HTTP request handler (one instance per request, run in its own thread by ThreadingHTTPServer).
# REST-style API on a single flat folder:
#   GET    /                 browser page (no auth)
#   GET    /api/files        JSON list of {name, size, mtime}                 (auth)
#   GET    /api/files/<name> download, streamed in 1 MiB chunks                 (auth)
#   PUT    /api/files/<name> upload, streamed to <name>.part then renamed       (auth)
#   DELETE /api/files/<name> delete                                             (auth)
# `cfg` is set once by cmd_serve before any request arrives and is shared read-only by all threads.
class Handler(http.server.BaseHTTPRequestHandler):
    # Loaded configuration dict (see cmd_serve); a class attribute because handler instances are created by the server.
    cfg = None

    # Value of the HTTP Server header: names the program without leaking the Python version.
    server_version = "kloud/1"

    def log_message(self, fmt, *a):
        """Write access-log lines to stderr (which cmd_start redirects into .kloud/server.log).

        Overrides the default to keep the standard format but never log request bodies or headers, so the token is not logged.
        """
        sys.stderr.write("%s - - [%s] %s\n" % (self.address_string(), self.log_date_time_string(), fmt % a))

    def _authed(self):
        """Return True if the request carries a valid `Authorization: Bearer <token>` header.

        The submitted token is hashed with the stored salt and compared with hmac.compare_digest, a constant-time
        comparison, so response timing does not reveal how many leading characters matched.
        """
        auth = self.headers.get("Authorization", "")
        if not auth.startswith("Bearer "):
            return False
        token = auth[len("Bearer "):].strip()
        given_hash = hash_token(token, self.cfg["salt"])
        return hmac.compare_digest(given_hash, self.cfg["token_hash"])

    def _deny(self):
        """Send 401 Unauthorized with a WWW-Authenticate header (the HTTP way to say "a token is required")."""
        self.send_response(401)
        self.send_header("WWW-Authenticate", 'Bearer realm="kloud"')
        self.end_headers()

    def _safe_path(self, name):
        """Map a URL file name to a path inside the storage root, or None if the name is not acceptable.

        Path-traversal defence: the name is percent-decoded, then anything containing "/" or equal to "." or
        ".." is refused, so the result is always a direct child of the root and `../secret` cannot escape. The
        folder is flat by design; sub-directories are not supported. (A name with a backslash or NUL is not
        specially handled; on POSIX a backslash is an ordinary character.)
        """
        name = unquote(name)
        if not name or "/" in name or name in (".", ".."):
            return None
        return Path(self.cfg["root"]) / name

    def do_GET(self):
        """Handle GET: the web page, the file list, and file downloads."""
        parsed = urlparse(self.path)

        # The page itself is public so a browser can load it before a token has been typed.
        if parsed.path == "/":
            body = INDEX_HTML.encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        if parsed.path == "/api/files":
            if not self._authed():
                return self._deny()
            root = Path(self.cfg["root"])
            files = []
            for p in sorted(root.iterdir()):
                # Hide in-progress uploads (.part files) and sub-directories from the listing.
                if p.is_file() and not p.name.endswith(".part"):
                    st = p.stat()
                    files.append({
                        "name": p.name,
                        "size": st.st_size,
                        "mtime": datetime.fromtimestamp(st.st_mtime, tz=timezone.utc).isoformat(),
                    })
            body = json.dumps(files).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        if parsed.path.startswith("/api/files/"):
            if not self._authed():
                return self._deny()
            p = self._safe_path(parsed.path[len("/api/files/"):])
            if not p or not p.is_file():
                self.send_response(404)
                self.end_headers()
                return
            size = p.stat().st_size
            ctype = mimetypes.guess_type(p.name)[0] or "application/octet-stream"
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(size))
            self.send_header("Content-Disposition", f'attachment; filename="{p.name}"')
            self.end_headers()
            with p.open("rb") as f:
                # Stream in 1 MiB chunks so memory use stays constant for multi-gigabyte files.
                while chunk := f.read(1 << 20):
                    self.wfile.write(chunk)
            return
        self.send_response(404)
        self.end_headers()

    def do_PUT(self):
        """Handle PUT: upload a file, replacing any existing file of that name.

        Reads exactly Content-Length bytes in 1 MiB chunks into "<name>.part", then renames it into place.
        The rename is atomic on one filesystem, so readers never see a half-written file. Known limits: a
        client that disconnects early still leaves a truncated file that gets renamed into place (the loop
        just stops on an empty read), and there is no size limit or free-space check. Chunked uploads
        without Content-Length are treated as empty.
        """
        parsed = urlparse(self.path)
        if not parsed.path.startswith("/api/files/"):
            self.send_response(404); self.end_headers(); return
        if not self._authed():
            return self._deny()
        p = self._safe_path(parsed.path[len("/api/files/"):])
        if not p:
            self.send_response(400); self.end_headers(); return
        length = int(self.headers.get("Content-Length", 0))
        tmp = p.with_name(p.name + ".part")
        remaining = length
        with tmp.open("wb") as f:
            while remaining > 0:
                chunk = self.rfile.read(min(1 << 20, remaining))
                if not chunk:
                    break
                f.write(chunk)
                remaining -= len(chunk)
        tmp.replace(p)
        self.send_response(201)
        self.end_headers()

    def do_DELETE(self):
        """Handle DELETE: remove a file by name. Responds 204 on success, 404 if missing."""
        parsed = urlparse(self.path)
        if not parsed.path.startswith("/api/files/"):
            self.send_response(404); self.end_headers(); return
        if not self._authed():
            return self._deny()
        p = self._safe_path(parsed.path[len("/api/files/"):])
        if not p or not p.is_file():
            self.send_response(404); self.end_headers(); return
        p.unlink()
        self.send_response(204)
        self.end_headers()


# One thread per connection so a slow upload does not block other clients. daemon_threads lets the
# process exit without waiting for in-flight transfers.
class ThreadingHTTPServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True


def cmd_serve(args):
    """Run the HTTP(S) server in the foreground until interrupted (used directly or by cmd_start).

    Args: args.port (TCP port). Binds to 0.0.0.0 (all interfaces) so other devices can connect; restrict
    access with the firewall or WireGuard (see the checklist).
    """
    cfg = load_config()
    Handler.cfg = cfg
    server = ThreadingHTTPServer(("0.0.0.0", args.port), Handler)

    # Wrap the listening socket with TLS so the token and files are encrypted on the wire. The self-signed
    # cert gives encryption but no identity proof, hence the browser warning on first visit.
    if cfg.get("tls"):
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.load_cert_chain(cfg["cert"], cfg["key"])
        server.socket = ctx.wrap_socket(server.socket, server_side=True)
        scheme = "https"
    else:
        scheme = "http"
    print(f"kloud serving {cfg['root']} on {scheme}://0.0.0.0:{args.port}")
    print("Reach it from another machine on the LAN with this machine's IP, e.g.:")
    print(f"  curl -H 'Authorization: Bearer <token>' {scheme}://<this-machine-ip>:{args.port}/api/files")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


def main():
    """Parse the command line and dispatch; with no sub-command, open the interactive menu."""
    parser = argparse.ArgumentParser(prog="kloud", description="Self-hosted file store, zero dependencies.")
    sub = parser.add_subparsers(dest="cmd")

    p_init = sub.add_parser("init", help="point kloud at a folder/drive and generate an access token")
    p_init.add_argument("--root", required=True, help="path to store files in (e.g. your external SSD)")
    p_init.add_argument("--tls", action="store_true", help="generate a self-signed cert and serve over https")
    p_init.set_defaults(func=cmd_init)

    p_token = sub.add_parser("token-new", help="revoke the old token and issue a new one")
    p_token.set_defaults(func=cmd_token_new)

    p_serve = sub.add_parser("serve", help="start the server")
    p_serve.add_argument("--port", type=int, default=8443)
    p_serve.set_defaults(func=cmd_serve)

    p_safety = sub.add_parser("safety", help="print the security checklist and run live checks")
    p_safety.set_defaults(func=cmd_safety)

    p_menu = sub.add_parser("menu", help="interactive menu (same as running kloud with no arguments)")
    p_menu.set_defaults(func=cmd_menu)

    p_start = sub.add_parser("start", help="start the server in the background")
    p_start.add_argument("--port", type=int, default=8443)
    p_start.set_defaults(func=cmd_start)

    p_stop = sub.add_parser("stop", help="stop the background server")
    p_stop.set_defaults(func=cmd_stop)

    p_status = sub.add_parser("status", help="show storage/server/VPN/sync/schedule status")
    p_status.set_defaults(func=cmd_status)

    # Sub-command functions are attached with set_defaults(func=...); a bare `kloud` means "menu".
    args = parser.parse_args()
    if args.cmd is None:
        cmd_menu(args)
    else:
        args.func(args)


if __name__ == "__main__":
    main()
