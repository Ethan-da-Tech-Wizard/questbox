def load_config():
    """Read .kloud/config.json and return it as a dict.

    Exits with a hint to run `kloud init` when the file does not exist, which turns a missing setup into
    a readable message instead of a traceback.
    """

    # Not configured yet: a clear instruction is more useful than a FileNotFoundError traceback.
    if not CONFIG_PATH.exists():
        sys.exit("No config found. Run `kloud init --root /path/to/drive` first.")
    return json.loads(CONFIG_PATH.read_text())


def save_config(cfg):
    """Write `cfg` to .kloud/config.json (creating the folder) with owner-only permissions.

    Args:
        cfg: dict with root, salt, token_hash, tls and optionally cert and key.

    The chmod to 0o600 matters: the file holds the token hash and salt, which an attacker could use to
    test password guesses offline, so other local users must not read it.
    """
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps(cfg, indent=2))
    os.chmod(CONFIG_PATH, 0o600)


def hash_token(token, salt):
    """Return the PBKDF2-HMAC-SHA256 hash (hex) of `token` using the hex-encoded `salt`.

    200,000 iterations make each guess slow, which hurts an attacker who steals config.json; a real
    request pays that cost once per call, which is acceptable for a personal server. The token is a
    random 32-byte value, so brute force is already impractical; the hash mainly protects against
    the config file leaking.
    """
    return hashlib.pbkdf2_hmac("sha256", token.encode(), bytes.fromhex(salt), 200_000).hex()


def _read_state():
    """Return the saved server state dict, or {} when the file is missing or unreadable.

    A corrupt state file is treated as "nothing running" rather than crashing status commands.
    """
    if STATE_PATH.exists():
        try:
            return json.loads(STATE_PATH.read_text())

        # No network at all: fall back to loopback so callers still print a usable (local-only) URL.
        except Exception:
            return {}
    return {}


def _pid_alive(pid):
    """Return True if a process with this pid exists.

    os.kill(pid, 0) sends no signal; it only checks existence and permission. A pid that was reused by an
    unrelated process would look alive, a small risk accepted for a personal tool.
    """
    try:
        os.kill(pid, 0)
        return True
    except (OSError, TypeError):
        return False


def _running_info():
    """Return (running, pid, port) for the background server from state.json and a liveness check."""
    st = _read_state()
    pid = st.get("pid")
    if pid and _pid_alive(pid):
        return True, pid, st.get("port")
    return False, None, None


def lan_ip():
    """Best-effort local network address -- opens no real connection, just
    asks the OS which interface would be used, so it works offline too."""
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)

        # Connecting a UDP socket sends no packet; it only makes the OS choose the outgoing interface, whose
        # address getsockname() then returns. 8.8.8.8 is just a routable address, never contacted.
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return "127.0.0.1"


def bonjour_host():
    """This machine's mDNS/.local name, if it has one (macOS advertises this
    by default). Unlike a raw IP, it keeps working across DHCP renewals and
    WiFi band switches -- worth using instead of the IP on flaky networks."""
    try:
        # macOS stores the Bonjour name here. The 2 s timeout keeps status commands snappy if scutil hangs.
        r = subprocess.run(["scutil", "--get", "LocalHostName"], capture_output=True, text=True, timeout=2)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip() + ".local"

    # scutil does not exist off macOS; treat that and a hang the same way: no .local name available.
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass
    return None


def _reachable_at(scheme, port):
    """Return a user-facing message saying how to reach the server (a .local name if available, plus the IP).

    Args:
        scheme: "http" or "https".
        port: TCP port the server listens on.
    """
    host = bonjour_host()
    if host:
        return (
            f"Reach it at: {scheme}://{host}:{port}/  (this keeps working even if your\n"
            f"  WiFi switches bands and your IP changes)\n"
            f"Or by current IP: {scheme}://{lan_ip()}:{port}/"
        )
    return f"Reach it at: {scheme}://{lan_ip()}:{port}/  (from another device on this network, or over the VPN)"


def cmd_start(args):
    """Start `kloud serve` as a detached background process and record it in state.json.

    Args: args.port (optional, default 8443). Does nothing if a live server is already recorded.
    """
    if not CONFIG_PATH.exists():
        sys.exit("Not set up yet -- run the guided setup first (menu option 1, or `kloud init --root ...`).")
    # Refuse to start a second server: two processes would fight over the same port and state file.
    running, pid, _ = _running_info()
    if running:
        print(f"Already running (pid {pid}).")
        return

    # 8443 is the conventional alternative HTTPS port; getattr because the menu passes a bare Namespace.
    port = getattr(args, "port", None) or 8443
    log_path = HERE / ".kloud" / "server.log"
    log_path.parent.mkdir(parents=True, exist_ok=True)

    # Append mode keeps the log from earlier runs. start_new_session detaches the child from this
    # terminal, so closing the terminal does not kill the server (it would otherwise get SIGHUP).
    with open(log_path, "ab") as logf:
        proc = subprocess.Popen(
            [sys.executable, str(HERE / "kloud"), "serve", "--port", str(port)],
            stdout=logf, stderr=subprocess.STDOUT, start_new_session=True,
        )

    # Short grace period, then poll(): if the child already exited (port in use, bad config), report it
    # now instead of claiming success.
    time.sleep(0.5)
    if proc.poll() is not None:
        sys.exit(f"Server failed to start -- check {log_path} for details.")

    # Remember pid and port so `stop` and `status` (and the menu) can find the server later.
    STATE_PATH.write_text(json.dumps(
        {"pid": proc.pid, "port": port, "started_at": datetime.now(timezone.utc).isoformat()}, indent=2
    ))
    cfg = json.loads(CONFIG_PATH.read_text())
    scheme = "https" if cfg.get("tls") else "http"
    print(f"Server started in the background (pid {proc.pid}).")
    print(_reachable_at(scheme, port))


def cmd_stop(args):
    """Stop the background server with SIGTERM and clear state.json."""

    # Nothing recorded as running (or the recorded pid is dead): say so instead of failing.
    running, pid, _ = _running_info()
    if not running:
        print("Server isn't running.")
        return
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass

    # Wait up to 4 s (20 x 0.2 s) for the server to exit; the state file is removed regardless, so a stuck
    # process never blocks a restart attempt. No SIGKILL is sent.
    for _ in range(20):
        if not _pid_alive(pid):
            break
        time.sleep(0.2)
    if STATE_PATH.exists():
        STATE_PATH.unlink()
    print("Server stopped.")


