#!/usr/bin/env python3
"""
kloud -- a self-hosted, zero-dependency file store.

Point it at a folder (an external SSD, say), start it, and push/pull files
to it over plain HTTP(S) with a shared bearer token. No accounts, no
third-party relay, no telemetry -- just this process, this filesystem, and
a token only you hold. Python 3 stdlib only, same rule as questbox/qb.

See README.md for the multi-node rotation design (phase 2).
"""
import argparse
import hashlib
import hmac
import http.server
import json
import mimetypes
import os
import secrets
import signal
import socket
import socketserver
import ssl
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import unquote, urlparse

HERE = Path(__file__).resolve().parent
CONFIG_PATH = HERE / ".kloud" / "config.json"
STATE_PATH = HERE / ".kloud" / "state.json"
VPN_SCRIPT = HERE / "kloud-vpn"
SYNC_SCRIPT = HERE / "kloud-sync"
SCHEDULE_SCRIPT = HERE / "kloud-schedule"


def load_config():
    if not CONFIG_PATH.exists():
        sys.exit("No config found. Run `kloud init --root /path/to/drive` first.")
    return json.loads(CONFIG_PATH.read_text())


def save_config(cfg):
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_PATH.write_text(json.dumps(cfg, indent=2))
    os.chmod(CONFIG_PATH, 0o600)


def hash_token(token, salt):
    return hashlib.pbkdf2_hmac("sha256", token.encode(), bytes.fromhex(salt), 200_000).hex()


def _read_state():
    if STATE_PATH.exists():
        try:
            return json.loads(STATE_PATH.read_text())
        except Exception:
            return {}
    return {}


def _pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (OSError, TypeError):
        return False


def _running_info():
    st = _read_state()
    pid = st.get("pid")
    if pid and _pid_alive(pid):
        return True, pid, st.get("port")
    return False, None, None


def lan_ip():
    """Best-effort local network address -- opens no real connection, just
    asks the OS which interface would be used, so it works offline too."""
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return "127.0.0.1"


def bonjour_host():
    """This machine's mDNS/.local name, if it has one (macOS advertises this
    by default). Unlike a raw IP, it keeps working across DHCP renewals and
    WiFi band switches -- worth using instead of the IP on flaky networks."""
    try:
        r = subprocess.run(["scutil", "--get", "LocalHostName"], capture_output=True, text=True, timeout=2)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip() + ".local"
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass
    return None


def _reachable_at(scheme, port):
    host = bonjour_host()
    if host:
        return (
            f"Reach it at: {scheme}://{host}:{port}/  (this keeps working even if your\n"
            f"  WiFi switches bands and your IP changes)\n"
            f"Or by current IP: {scheme}://{lan_ip()}:{port}/"
        )
    return f"Reach it at: {scheme}://{lan_ip()}:{port}/  (from another device on this network, or over the VPN)"


def cmd_start(args):
    if not CONFIG_PATH.exists():
        sys.exit("Not set up yet -- run the guided setup first (menu option 1, or `kloud init --root ...`).")
    running, pid, _ = _running_info()
    if running:
        print(f"Already running (pid {pid}).")
        return
    port = getattr(args, "port", None) or 8443
    log_path = HERE / ".kloud" / "server.log"
    log_path.parent.mkdir(parents=True, exist_ok=True)
    with open(log_path, "ab") as logf:
        proc = subprocess.Popen(
            [sys.executable, str(HERE / "kloud"), "serve", "--port", str(port)],
            stdout=logf, stderr=subprocess.STDOUT, start_new_session=True,
        )
    time.sleep(0.5)
    if proc.poll() is not None:
        sys.exit(f"Server failed to start -- check {log_path} for details.")
    STATE_PATH.write_text(json.dumps(
        {"pid": proc.pid, "port": port, "started_at": datetime.now(timezone.utc).isoformat()}, indent=2
    ))
    cfg = json.loads(CONFIG_PATH.read_text())
    scheme = "https" if cfg.get("tls") else "http"
    print(f"Server started in the background (pid {proc.pid}).")
    print(_reachable_at(scheme, port))


def cmd_stop(args):
    running, pid, _ = _running_info()
    if not running:
        print("Server isn't running.")
        return
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    for _ in range(20):
        if not _pid_alive(pid):
            break
        time.sleep(0.2)
    if STATE_PATH.exists():
        STATE_PATH.unlink()
    print("Server stopped.")


def cmd_status(args):
    print("--- kloud status ---")
    if CONFIG_PATH.exists():
        cfg = json.loads(CONFIG_PATH.read_text())
        print(f"storage folder: {cfg['root']}")
        print(f"HTTPS: {'on' if cfg.get('tls') else 'off'}")
    else:
        print("storage: not set up yet")
    running, pid, port = _running_info()
    if running:
        cfg = json.loads(CONFIG_PATH.read_text())
        scheme = "https" if cfg.get("tls") else "http"
        print(f"server: ON (pid {pid})")
        print(_reachable_at(scheme, port))
    else:
        print("server: off")
    if (HERE / ".kloud" / "wg" / "wg0.conf").exists():
        print("VPN: configured")
    else:
        print("VPN: not set up")
    sync_cfg_path = HERE / ".kloud" / "sync.json"
    if sync_cfg_path.exists():
        s = json.loads(sync_cfg_path.read_text())
        print(f"sync partner: {s.get('peer_user')}@{s.get('peer_host')}:{s.get('peer_root')}")
        print(f"last synced: {s.get('last_sync') or 'never yet'}")
    else:
        print("sync: not set up")
    sched_path = HERE / ".kloud" / "schedule.json"
    if sched_path.exists():
        sc = json.loads(sched_path.read_text())
        print(f"schedule: live {sc['start']}-{sc['end']} daily ({'on' if sc.get('enabled', True) else 'paused'})")
    else:
        print("schedule: none (server stays as you leave it)")


def make_self_signed_cert():
    cert_dir = HERE / ".kloud"
    cert_dir.mkdir(parents=True, exist_ok=True)
    cert, key = cert_dir / "cert.pem", cert_dir / "key.pem"
    subprocess.run(
        [
            "openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes",
            "-keyout", str(key), "-out", str(cert), "-days", "3650",
            "-subj", "/CN=kloud-local",
        ],
        check=True, capture_output=True,
    )
    return cert, key


def cmd_init(args):
    root = Path(args.root).expanduser().resolve()
    root.mkdir(parents=True, exist_ok=True)
    salt = secrets.token_hex(16)
    token = secrets.token_urlsafe(32)
    cfg = {
        "root": str(root),
        "salt": salt,
        "token_hash": hash_token(token, salt),
        "tls": bool(args.tls),
    }
    if args.tls:
        cert, key = make_self_signed_cert()
        cfg["cert"] = str(cert)
        cfg["key"] = str(key)
    save_config(cfg)
    print(f"Storage root: {root}")
    print(f"Your access token (save this now, it will not be shown again):\n")
    print(f"  {token}\n")
    print("Give this token only to devices you want to allow (curl, browser, etc).")


def cmd_token_new(args):
    cfg = load_config()
    salt = secrets.token_hex(16)
    token = secrets.token_urlsafe(32)
    cfg["salt"] = salt
    cfg["token_hash"] = hash_token(token, salt)
    save_config(cfg)
    print(f"New token (old one is now invalid):\n\n  {token}\n")


SAFETY_CHECKLIST = """
kloud safety checklist
-----------------------
1. Never paste your access token into a chat, screenshot, or commit.
   `.kloud/` holds it (hashed, but still) -- keep it out of git.
2. Don't expose `kloud serve` straight to the open internet. Off your own
   LAN, use --tls AND put it behind your own WireGuard tunnel (kloud-vpn)
   -- plain HTTP off-LAN means the token and every file are readable by
   anything sitting between you and the server.
3. Lost a device that had the token, or unsure who still has it?
   Run `kloud token-new` right away -- it invalidates the old one.
4. Only forward WireGuard's UDP port on your router, never kloud's
   HTTP(S) port directly.
5. Back up `.kloud/wg/*.key` somewhere safe -- lose it and you have to
   regenerate the tunnel and re-share public keys with every peer.
6. A self-signed TLS cert means your browser warns once, on first visit
   -- that's normal. If that warning changes on a LATER visit to the
   same server, stop and verify before trusting it; that's the one sign
   worth treating as suspicious.
"""


def cmd_safety(args):
    print(SAFETY_CHECKLIST)
    print("--- live checks ---")
    if CONFIG_PATH.exists():
        print(f"[ok] storage configured ({CONFIG_PATH})")
        cfg = json.loads(CONFIG_PATH.read_text())
        tls_on = bool(cfg.get("tls"))
        print(f"[{'ok' if tls_on else 'warn'}] TLS {'enabled' if tls_on else 'disabled -- fine on a trusted LAN only'}")
        mode = oct(CONFIG_PATH.stat().st_mode)[-3:]
        print(f"[{'ok' if mode == '600' else 'warn'}] config file permissions are {mode} (want 600)")
    else:
        print("[--] storage not initialized yet (`kloud init`)")
    wg_dir = HERE / ".kloud" / "wg"
    print(f"[{'ok' if wg_dir.exists() else '--'}] VPN {'configured' if wg_dir.exists() else 'not set up yet (`kloud-vpn`)'}")
    try:
        ignored = subprocess.run(
            ["git", "check-ignore", "-q", str(HERE / ".kloud")],
            cwd=HERE, capture_output=True,
        ).returncode == 0
        print(f"[{'ok' if ignored else 'warn'}] .kloud/ is {'git-ignored' if ignored else 'NOT confirmed git-ignored -- check .gitignore!'}")
    except FileNotFoundError:
        print("[--] git not available, couldn't verify .gitignore coverage")


def _ask(prompt, default=None):
    suffix = f" [{default}]" if default else ""
    val = input(f"{prompt}{suffix}: ").strip()
    return val or default


def _status_line():
    storage = "set up" if CONFIG_PATH.exists() else "NOT set up"
    running, _, _ = _running_info()
    server = "ON" if running else "off"
    vpn = "connected" if (HERE / ".kloud" / "wg" / "wg0.conf").exists() else "not set up"
    sync = "set up" if (HERE / ".kloud" / "sync.json").exists() else "not set up"
    return f"storage: {storage}  |  server: {server}  |  VPN: {vpn}  |  sync: {sync}"


def wizard_first_time():
    print("\nLet's get you set up -- takes about a minute.\n")
    if CONFIG_PATH.exists():
        if _ask("kloud is already set up on this machine. Start over from scratch?", "n").lower() != "y":
            return
    root = _ask("Where should your files be stored? (e.g. /Volumes/YourSSD/kloud-data)")
    if not root:
        print("No folder given -- cancelled.")
        return
    tls = _ask("Encrypt traffic with HTTPS? Recommended if this ever leaves your home network (y/n)", "y").lower() != "n"
    cmd_init(argparse.Namespace(root=root, tls=tls))
    print("\nStorage is ready.")
    if _ask("Turn the server on now, in the background?", "y").lower() != "n":
        cmd_start(argparse.Namespace(port=8443))
    print("\nThat's the basics done. If you want to reach this from a machine that")
    print("ISN'T on the same WiFi/network, set up the VPN next (menu option 4).")
    print("If it's the same network, you're already good to go.")


def wizard_token():
    if not CONFIG_PATH.exists():
        print("Set up storage first (option 1).")
        return
    print("\nYour access token works like a password -- anyone holding it can see")
    print("and change your files. We only ever store a scrambled copy of it, so")
    print("we can't show you the current one again if you've lost it.")
    if _ask("Generate a brand-new token now? The old one stops working", "n").lower() == "y":
        cmd_token_new(argparse.Namespace())


def wizard_vpn():
    print("\nThis connects your two machines securely over the internet, so they")
    print("don't need to be on the same WiFi. Do this once on EACH machine.")
    self_path = HERE / ".kloud" / "wg" / "self.json"
    if not self_path.exists():
        print("\nFirst, this machine needs its own identity.")
        name = _ask("A short name for THIS machine", "machine1")
        addr = _ask("A private tunnel address for it", "10.66.0.1/24")
        r = subprocess.run([str(VPN_SCRIPT), "init", "--name", name, "--address", addr])
        if r.returncode != 0:
            return
        self_path = HERE / ".kloud" / "wg" / "self.json"
    if self_path.exists():
        self_cfg = json.loads(self_path.read_text())
        print(f"\nThis machine is '{self_cfg['name']}' at {self_cfg['address']}.")
        print(f"Its public key (share this with the other machine's operator):\n  {self_cfg['pubkey']}")
    if _ask("\nAdd/update the OTHER machine's details now?", "y").lower() != "n":
        pname = _ask("Name for the other machine", "machine2")
        pkey = _ask("Its public key (it gets this from running this same step there)")
        pend = _ask("How to reach it -- address:port, e.g. its-name.duckdns.org:51820")
        paddr = _ask("Its private tunnel address", "10.66.0.2/32")
        if not (pkey and pend):
            print("Need its public key and address to continue -- cancelled.")
            return
        subprocess.run([str(VPN_SCRIPT), "peer", "add", "--name", pname, "--pubkey", pkey,
                         "--endpoint", pend, "--allowed-ips", paddr])
        subprocess.run([str(VPN_SCRIPT), "config"])


def wizard_sync():
    if not CONFIG_PATH.exists():
        print("Set up storage first (option 1).")
        return
    sync_cfg_path = HERE / ".kloud" / "sync.json"
    if not sync_cfg_path.exists():
        print("\nFirst time syncing -- let's set up where the other machine is.")
        host = _ask("The other machine's address (its VPN address, e.g. 10.66.0.2)")
        user = _ask("Username to log into it over ssh")
        root = _ask("Its kloud storage folder path")
        if not (host and user and root):
            print("Need all three -- cancelled.")
            return
        r = subprocess.run([str(SYNC_SCRIPT), "setup", "--peer-host", host,
                             "--peer-user", user, "--peer-root", root])
        if r.returncode != 0:
            return
    print("\nSyncing now...")
    subprocess.run([str(SYNC_SCRIPT), "now"])


def wizard_schedule():
    print("\nSet the hours THIS machine should be on and syncing. Outside those")
    print("hours it turns itself off, so it isn't running around the clock.")
    start = _ask("Turn on at (24h HH:MM, e.g. 21:00)")
    end = _ask("Turn off at (24h HH:MM, e.g. 07:00)")
    if not (start and end):
        print("Need both times -- cancelled.")
        return
    r = subprocess.run([str(SCHEDULE_SCRIPT), "set", "--start", start, "--end", end])
    if r.returncode != 0:
        return
    if _ask("Make this happen automatically in the background?", "y").lower() != "n":
        r = subprocess.run([str(SCHEDULE_SCRIPT), "install"])
        if r.returncode != 0:
            print(f"You can still trigger a check by hand any time with: {SCHEDULE_SCRIPT} run")


MENU = """
================ kloud ================
{status}
-----------------------------------------
 1) First time here? Start guided setup
 2) Turn the server ON
 3) Turn the server OFF
 4) Connect this machine to another one (VPN)
 5) Sync files with the other machine now
 6) Set an automatic schedule (so it's not on 24/7)
 7) Show full status
 8) Manage my access token
 9) Security tips
10) Quit
"""


def cmd_menu(args):
    while True:
        print(MENU.format(status=_status_line()))
        choice = input("> ").strip().lower()
        try:
            if choice == "1":
                wizard_first_time()
            elif choice == "2":
                cmd_start(argparse.Namespace(port=8443))
            elif choice == "3":
                cmd_stop(argparse.Namespace())
            elif choice == "4":
                wizard_vpn()
            elif choice == "5":
                wizard_sync()
            elif choice == "6":
                wizard_schedule()
            elif choice == "7":
                cmd_status(argparse.Namespace())
            elif choice == "8":
                wizard_token()
            elif choice == "9":
                cmd_safety(argparse.Namespace())
            elif choice in ("10", "q", "quit", "exit"):
                break
            else:
                print("Please enter a number from the menu.")
        except SystemExit as e:
            print(f"\n{e.code if isinstance(e.code, str) else 'That step stopped early.'}")
            print("Nothing was damaged -- you're back at the menu.")
        except Exception as e:
            print(f"\nSomething went wrong: {e}")
            print("Nothing was damaged -- you're back at the menu.")


