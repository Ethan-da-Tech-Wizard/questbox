# Everything lives next to the script (not in the user's home) so the whole tool can be carried on
# the same drive it manages. resolve() follows symlinks so the path is stable.
HERE = Path(__file__).resolve().parent

# Persistent settings; created by `kloud init`.
CONFIG_PATH = HERE / ".kloud" / "config.json"

# Runtime state of the background server (pid, port, start time); removed by `kloud stop`.
STATE_PATH = HERE / ".kloud" / "state.json"

# Sibling scripts invoked by the wizards; resolved from HERE so they work from any working directory.
