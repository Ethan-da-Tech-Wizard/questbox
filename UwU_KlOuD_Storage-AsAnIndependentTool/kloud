def make_self_signed_cert():
    """Create a self-signed certificate and key in .kloud/ with openssl and return (cert_path, key_path).

    RSA 2048, valid 10 years (-days 3650), no passphrase (-nodes) because the server must start
    unattended. Self-signed means browsers warn on first visit (see the safety checklist). Raises
    subprocess.CalledProcessError when openssl fails and FileNotFoundError when it is not installed.
    """
    cert_dir = HERE / ".kloud"
    cert_dir.mkdir(parents=True, exist_ok=True)
    cert, key = cert_dir / "cert.pem", cert_dir / "key.pem"
    subprocess.run(
        [
            "openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes",
            "-keyout", str(key), "-out", str(cert), "-days", "3650",
            "-subj", "/CN=kloud-local",
        ],
        check=True, capture_output=True,
    )
    return cert, key


def cmd_init(args):
    """Create the configuration: storage root, a new random token, and optionally a TLS certificate.

    Args: args.root (folder to store files in, created if needed), args.tls (bool).

    The token is generated here, printed once, and only its salted hash is saved, so nobody (not even
    this program) can show it again later. Running init again replaces the config and invalidates
    the old token.
    """
    root = Path(args.root).expanduser().resolve()
    root.mkdir(parents=True, exist_ok=True)

    # Fresh 16-byte random salt per token, so identical tokens never produce identical hashes.
    salt = secrets.token_hex(16)

    # 32 random bytes (256 bits) from the OS CSPRNG, URL-safe so it can be pasted into headers and curl.
    token = secrets.token_urlsafe(32)

    # Config schema: root (storage folder), salt + token_hash (see hash_token), tls flag, and cert/key
    # paths added below when TLS is chosen.
    cfg = {
        "root": str(root),
        "salt": salt,
        "token_hash": hash_token(token, salt),
        "tls": bool(args.tls),
    }
    if args.tls:
        cert, key = make_self_signed_cert()
        cfg["cert"] = str(cert)
        cfg["key"] = str(key)
    save_config(cfg)
    print(f"Storage root: {root}")

    # The only time the plaintext token exists outside the user's own storage; it is not saved anywhere.
    print(f"Your access token (save this now, it will not be shown again):\n")
    print(f"  {token}\n")
    print("Give this token only to devices you want to allow (curl, browser, etc).")


def cmd_token_new(args):
    """Issue a new token, replacing the stored hash so the previous token stops working immediately."""
    cfg = load_config()
    salt = secrets.token_hex(16)
    token = secrets.token_urlsafe(32)
    cfg["salt"] = salt
    cfg["token_hash"] = hash_token(token, salt)
    save_config(cfg)
    print(f"New token (old one is now invalid):\n\n  {token}\n")


