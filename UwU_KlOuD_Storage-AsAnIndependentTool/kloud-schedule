#!/usr/bin/env python3
# ==============================================================================
# Program: kloud-schedule
# Programmer: Ethan-da-Tech-Wizard
# Last Modified: November 18, 2026
# Purpose: Time-windowed scheduler managing automated startup, periodic delta
#          synchronization, and shutdown of kloud nodes via cron automation.
# ==============================================================================
"""
kloud-schedule -- turns this machine's kloud server (and a sync pass) on
and off on a daily time window, so it isn't running 24/7. Driven by cron
(standard on macOS/Linux, not a service) calling `kloud-schedule run`
every few minutes.
"""

# Fit: part of the kloud family (see the architecture note in `kloud`). `kloud` (menu option 6) calls
# `set` and `install` here; once installed, cron runs `kloud-schedule run` every few minutes, and that tick
# starts or stops the kloud server (and runs kloud-sync) depending on the clock.
#
# State: .kloud/schedule.json {start, end, enabled}. The server's state file .kloud/state.json is read
# to learn whether it is running.
# Behaviour of one tick (cmd_run): inside the window -> make sure the server is on and sync; outside the
# window -> do a last sync, then stop the server. The tick is idempotent, so running it more often than
# needed is harmless.
# Limits: times are the machine's local clock (daylight-saving changes shift the window); invalid
# HH:MM values raise a ValueError traceback; cron must exist (see cmd_install).
import argparse
import json
import os
import subprocess
import sys
from datetime import datetime, time as dtime
from pathlib import Path

# State lives in .kloud/ next to the script, shared with kloud and kloud-sync.
HERE = Path(__file__).resolve().parent
SCHEDULE_CONFIG = HERE / ".kloud" / "schedule.json"
STATE_PATH = HERE / ".kloud" / "state.json"
SYNC_CONFIG = HERE / ".kloud" / "sync.json"
KLOUD = HERE / "kloud"
SYNC = HERE / "kloud-sync"

# Marker appended to our crontab line. install/uninstall find and replace exactly their own line by this text and never touch the user's other entries.
CRON_MARKER = "# kloud-schedule (questbox)"


def _parse_hhmm(s):
    """Convert "HH:MM" (24 hour) to a datetime.time. Raises ValueError for a malformed or out-of-range value."""
    h, m = s.split(":")
    return dtime(int(h), int(m))


def cmd_set(args):
    """Validate and save the daily on/off window (args.start, args.end as "HH:MM"), enabled by default.

    Parsing both values first means nothing is written if either is invalid.
    """
    _parse_hhmm(args.start)
    _parse_hhmm(args.end)
    SCHEDULE_CONFIG.parent.mkdir(parents=True, exist_ok=True)
    SCHEDULE_CONFIG.write_text(json.dumps({"start": args.start, "end": args.end, "enabled": True}, indent=2))
    print(f"This machine will be live from {args.start} to {args.end} every day.")


def _in_window(now_t, start_t, end_t):
    """Return True if clock time `now_t` falls inside the daily window [start_t, end_t).

    The window is half-open (start included, end excluded) so there is no double-counted minute. When
    start is later than end (for example 21:00 to 07:00) the window wraps past midnight and the test
    becomes "after start OR before end".
    """
    if start_t <= end_t:
        return start_t <= now_t < end_t
    return now_t >= start_t or now_t < end_t  # window wraps past midnight


def load_schedule():
    """Return the saved schedule dict, or None when no schedule has been set."""
    if not SCHEDULE_CONFIG.exists():
        return None
    return json.loads(SCHEDULE_CONFIG.read_text())


def cmd_status(args):
    """Print the saved window, whether it is enabled, and whether the clock is inside it right now."""
    sched = load_schedule()
    if not sched:
        print("No schedule set -- `kloud-schedule set --start HH:MM --end HH:MM`.")
        return
    now_t = datetime.now().time()
    inside = _in_window(now_t, _parse_hhmm(sched["start"]), _parse_hhmm(sched["end"]))
    print(f"Window: {sched['start']} - {sched['end']} daily")
    print(f"Enabled: {sched.get('enabled', True)}")
    print(f"Right now: {'inside window (should be live)' if inside else 'outside window (should be off)'}")


def _is_running():
    """Return True if the kloud server recorded in state.json is alive (pid exists).

    Reads the file directly instead of importing kloud, so this script has no dependency on it. Any read problem counts as "not running".
    """
    if not STATE_PATH.exists():
        return False
    try:
        pid = json.loads(STATE_PATH.read_text()).get("pid")
    except Exception:
        return False
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def cmd_run(args):
    """One scheduler tick: bring the server and sync into the state the window says they should be in.

    Does nothing when no schedule exists or it is disabled. Sync runs only if a partner is configured
    (kloud-sync exists and sync.json is present). Output goes to cron's mail/log, so it stays quiet.
    """
    sched = load_schedule()
    if not sched or not sched.get("enabled", True):
        return
    now_t = datetime.now().time()
    inside = _in_window(now_t, _parse_hhmm(sched["start"]), _parse_hhmm(sched["end"]))
    running = _is_running()
    have_sync_partner = SYNC.exists() and SYNC_CONFIG.exists()

    # Inside the window: start if needed, then sync on every tick so changes propagate promptly.
    if inside:
        if not running:
            subprocess.run([str(KLOUD), "start"])
        if have_sync_partner:
            subprocess.run([str(SYNC), "now"])

    # Outside the window: sync one last time before shutting down so the partner has the final changes.
    # If the server is already off nothing happens, so repeated ticks overnight do no work.
    else:
        if running:
            if have_sync_partner:
                subprocess.run([str(SYNC), "now"])
            subprocess.run([str(KLOUD), "stop"])


def _current_crontab():
    """Returns the existing crontab text, or None if `crontab` isn't available at all."""
    try:
        r = subprocess.run(["crontab", "-l"], capture_output=True, text=True)
    except FileNotFoundError:
        return None
    return r.stdout if r.returncode == 0 else ""


def cmd_install(args):
    """Add a cron job that runs `kloud-schedule run` every args.interval_minutes (default 5).

    Any earlier line with our marker is removed first, so installing twice never creates duplicates.
    Uses sys.executable so cron runs the same Python interpreter that installed it (cron has a minimal PATH).
    """
    existing = _current_crontab()
    if existing is None:
        sys.exit(
            "`cron` isn't available on this machine, so this can't run automatically.\n"
            f"You can still run `{KLOUD_SCHEDULE_HINT()} run` by hand whenever you want a check."
        )
    lines = [l for l in existing.splitlines() if CRON_MARKER not in l]
    lines.append(f"*/{args.interval_minutes} * * * * {sys.executable} {HERE / 'kloud-schedule'} run {CRON_MARKER}")
    new_crontab = "\n".join(lines) + "\n"
    r = subprocess.run(["crontab", "-"], input=new_crontab, text=True)
    if r.returncode != 0:
        sys.exit("Couldn't install the cron job.")
    print(f"Installed. This machine will check every {args.interval_minutes} minutes whether it should be on.")


def cmd_uninstall(args):
    """Remove our cron line (identified by CRON_MARKER) and leave all other crontab entries untouched.

    The server and sync stay in whatever state they are in; this only stops the automatic switching.
    """
    existing = _current_crontab()
    if existing is None:
        print("`cron` isn't available on this machine -- nothing to remove.")
        return
    lines = [l for l in existing.splitlines() if CRON_MARKER not in l]
    new_crontab = "\n".join(lines) + ("\n" if lines else "")
    r = subprocess.run(["crontab", "-"], input=new_crontab, text=True)
    if r.returncode != 0:
        sys.exit("Couldn't update crontab.")
    print("Removed the automatic schedule. Whatever on/off state it's in now, it'll stay in.")


def KLOUD_SCHEDULE_HINT():
    """Return the full path of this script, used in the "run it by hand" message when cron is unavailable."""
    return str(HERE / "kloud-schedule")


def main():
    """Parse arguments and dispatch to the cmd_* function for the chosen sub-command."""
    parser = argparse.ArgumentParser(prog="kloud-schedule", description="Rotate this machine's kloud server on a daily window.")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_set = sub.add_parser("set", help="set the daily on/off window")
    p_set.add_argument("--start", required=True, help="24h HH:MM, e.g. 21:00")
    p_set.add_argument("--end", required=True, help="24h HH:MM, e.g. 07:00")
    p_set.set_defaults(func=cmd_set)

    p_status = sub.add_parser("status", help="show the window and whether we're in it right now")
    p_status.set_defaults(func=cmd_status)

    p_run = sub.add_parser("run", help="the tick: start/stop/sync based on the current time (call from cron)")
    p_run.set_defaults(func=cmd_run)

    p_install = sub.add_parser("install", help="install a cron job that calls `run` periodically")
    p_install.add_argument("--interval-minutes", type=int, default=5)
    p_install.set_defaults(func=cmd_install)

    p_uninstall = sub.add_parser("uninstall", help="remove the cron job")
    p_uninstall.set_defaults(func=cmd_uninstall)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
